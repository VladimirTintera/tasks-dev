<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <!-- Must be the fully qualified name of TaskManagerStartupInitializer — androidx.startup
                 loads it reflectively, so a typo crashes the application at process start. -->
            <meta-data android:name="eu.tintera.background.tasks.TaskManagerStartupInitializer"
                android:value="androidx.startup" />
        </provider>

    </application>

</manifest>