<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <!-- Musí být plně kvalifikované jméno TaskManagerStartupInitializer — androidx.startup
                 ho načítá reflexí a při překlepu spadne aplikace už při startu procesu. -->
            <meta-data android:name="eu.tintera.background.tasks.TaskManagerStartupInitializer"
                android:value="androidx.startup" />
        </provider>

    </application>

</manifest>